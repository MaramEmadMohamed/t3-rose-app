# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your values stay on your machine.

# Rose App API (optional, this is the default)
NEXT_PUBLIC_API_BASE_URL=https://rose-app.elevate-bootcamp.cloud

# Test user token for development, until the login ticket is done.
# Ask the team lead for one. Only used when running `npm run dev`.
NEXT_PUBLIC_TEST_USER_TOKEN=
